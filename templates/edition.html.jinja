<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Daily Belle — {{ edition.date_display }}</title>
<meta name="description" content="Independent global humanitarian briefing — {{ edition.date_display }}">
<meta name="theme-color" content="#f1ecdf">
<link rel="alternate" type="application/rss+xml" title="The Daily Belle" href="{{ site_root }}feed.xml">
<link rel="stylesheet" href="{{ site_root }}static/style.css">
</head>
<body>
<div class="page">

  <header class="masthead">
    <hr class="rule-double">
    <h1>The Daily Belle</h1>
    <div class="tagline">Independent Global Humanitarian Briefing</div>
  </header>
  <div class="masthead-meta">
    <span>{{ edition.date_display_upper }}</span>
    <span>One World · One Daily Briefing</span>
    <span>Printed: {{ edition.printed_time }}</span>
  </div>

  <div class="edition-bar">
    <a class="btn-outline {{ 'disabled' if not older_url }}" {% if older_url %}href="{{ older_url }}"{% endif %}>&larr; Older</a>
    <div>
      <span class="browse-label">Browse editions</span>
      <select class="edition-select" onchange="if(this.value) window.location.href=this.value;">
        {% for opt in all_editions %}
        <option value="{{ opt.url }}" {{ 'selected' if opt.date == edition.date else '' }}>
          {{ opt.label }}{{ ' — Latest' if opt.is_latest else '' }}
        </option>
        {% endfor %}
      </select>
    </div>
    <a class="btn-outline {{ 'disabled' if not newer_url }}" {% if newer_url %}href="{{ newer_url }}"{% endif %}>Newer &rarr;</a>
  </div>

  <section class="briefing-grid">
    <div>
      <p class="eyebrow">The Briefing</p>
      <h2>Five stories shaping the day</h2>
      <ol class="top-five-list">
        {% for item in edition.top_five %}
        <li><span class="num">{{ '%02d' % item.rank }}</span><span>{{ item.text }}</span></li>
        {% endfor %}
      </ol>
    </div>
    <div class="top-story-box">
      <div class="top-story-head">
        <p class="eyebrow">Top Story</p>
        <span class="score-badge {{ score_class(edition.top_story.score) }}">{{ '%.1f' % edition.top_story.score }}</span>
      </div>
      <p class="top-story-quote">&ldquo;{{ edition.top_story.quote }}&rdquo;</p>
      <p class="top-story-label">{{ edition.top_story.label.upper() }}</p>

      <p class="sig-scale-title">Significance Scale</p>
      <div class="sig-scale-row"><span class="swatch sc-watch"></span><span class="lbl">Watch</span><span class="rng">1–3</span></div>
      <div class="sig-scale-row"><span class="swatch sc-serious"></span><span class="lbl">Serious</span><span class="rng">4–6</span></div>
      <div class="sig-scale-row"><span class="swatch sc-severe"></span><span class="lbl">Severe</span><span class="rng">7–8</span></div>
      <div class="sig-scale-row"><span class="swatch sc-critical"></span><span class="lbl">Critical</span><span class="rng">9–10</span></div>
    </div>
  </section>

  <nav class="nav">
    <div class="logo">&#120086;</div>
    {% for r in region_order %}
    <a href="#{{ r|replace(' / ', '-')|replace(' ', '-')|lower }}">{{ r.upper() }}</a>
    {% endfor %}
    <a href="#risks">RISKS</a>
  </nav>

  {% for region in region_order %}
  <section class="region" id="{{ region|replace(' / ', '-')|replace(' ', '-')|lower }}">
    <div class="region-head">
      <h2>{{ region }}</h2>
      <span class="count">{{ edition.sections[region]|length }} REPORT{{ 's' if edition.sections[region]|length != 1 else '' }}</span>
    </div>
    {% if edition.sections[region] %}
    <div class="report-grid">
      {% for rep in edition.sections[region] %}
      <article class="report">
        <div class="report-head">
          <h3>{{ rep.headline }}</h3>
          <span class="score-badge {{ score_class(rep.score) }}">{{ '%.1f' % rep.score }}</span>
        </div>
        <p class="body">{{ rep.body }}</p>
        {% if rep.verified_figures %}
        <div class="verified-box">
          <div class="vf-title">VERIFIED FIGURES</div>
          <ul>{% for f in rep.verified_figures %}<li>{{ f }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
        <p class="sources">Sources: {% for s in rep.sources %}{{ s }}{{ ', ' if not loop.last else '' }}{% endfor %}</p>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="empty-region-note">No developments met inclusion criteria for this region in the last 24 hours.</p>
    {% endif %}
  </section>
  {% endfor %}

  <section class="risks" id="risks">
    <p class="eyebrow">Early Warning Desk</p>
    <h2>Escalation risks</h2>
    <p class="sub">Signals that could materially worsen humanitarian conditions — next 72 hours.</p>
    <hr class="rule-double">
    {% if edition.escalation_risks %}
    <div class="risk-grid">
      {% for risk in edition.escalation_risks %}
      <div class="risk-item">
        <div class="risk-head">
          <h3>{{ risk.location }}</h3>
          <div class="risk-score">
            <span class="badge {{ score_class(risk.score) }}">{{ '%.1f' % risk.score }}</span>
            <span class="bar"></span>
          </div>
        </div>
        <p class="risk-label">Trigger</p>
        <p>{{ risk.trigger }}</p>
        <p class="risk-label">Potential Impact</p>
        <p>{{ risk.potential_impact }}</p>
        <p class="risk-sources">Confidence: {{ risk.confidence }} &middot; {{ risk.sources|join(' · ') }}</p>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="no-risks">No material escalation risks identified for the next 72 hours.</p>
    {% endif %}
  </section>

  <section class="limits">
    <p class="eyebrow">Reporting Record</p>
    <h2>Sources &amp; limitations</h2>
    <div class="limits-grid">
      <div>
        <h4>STRONGEST SOURCES</h4>
        <p class="strongest-sources">{{ edition.source_notes.strongest_sources|join(' · ') }}</p>
        <h4>EDITORIAL LIMITATIONS</h4>
        <ul>
          {% for l in edition.source_notes.limitations %}<li>{{ l }}</li>{% endfor %}
          <li>{{ edition.source_notes.internal_sources_confirmation }}</li>
        </ul>
      </div>
      <div class="snapshot-box">
        <h4>COVERAGE SNAPSHOT</h4>
        <div class="snapshot-row"><span>Outlets reviewed</span><span class="v">{{ edition.source_notes.coverage_snapshot.outlets_reviewed }}</span></div>
        <div class="snapshot-row"><span>Themes searched</span><span class="v">{{ edition.source_notes.coverage_snapshot.themes_searched }}</span></div>
        <div class="snapshot-row"><span>Items considered</span><span class="v">{{ edition.source_notes.coverage_snapshot.items_considered }}</span></div>
        <div class="snapshot-row"><span>Sources cited</span><span class="v">{{ edition.source_notes.coverage_snapshot.sources_cited }}</span></div>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div>
      <div class="brand">The Daily Belle</div>
      <div>HUMANITARIAN NEWS, RANKED FOR SIGNIFICANCE</div>
    </div>
    <div class="compiled-note">Compiled daily from public news reporting via an automated pipeline. Sources cited on every item.</div>
    <div class="meta-right">
      PRINTED: {{ edition.printed_time }}
      <span class="rss">Latest edition &middot; <a href="{{ site_root }}feed.xml">RSS feed</a> — subscribe in a feed reader, Slack, or Teams</span>
    </div>
  </footer>

</div>
<button class="to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})">&uarr; TOP</button>
</body>
</html>
